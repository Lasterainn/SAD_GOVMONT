<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the request is not for a real file or directory, route to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>