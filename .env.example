# ---- Aplikasi ----
APP_ENV=local            # local | production
APP_DEBUG=1                   # 0 di production, 1 utk testing
SESSION_LIFETIME=1800

# ---- Kunci kriptografi (jalanin "openssl rand -hex 32" di bash 3 kali, tiap key hrs beda) ----
APP_KEY=012...def   # AES-256-GCM, enkripsi NIK (32 byte)
NIK_PEPPER=012...def # HMAC-SHA256 untuk nik_hash (32 byte)
OTP_PEPPER=012...def  # HMAC untuk hash OTP admin/pemerintah

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jakarta_connect
DB_SCHEMA=jakarta_connect
DB_USER=postgres
DB_PASS=password_postgres #ur password

# ---- reCAPTCHA (masih yang default) ----
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ---- SMTP untuk OTP email (MFA admin & pemerintah) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=...
MAIL_PASSWORD=...
MAIL_FROM=no-reply@jakartaconnect.id