{
    "name": "govmont/jakarta-connect",
    "description": "Jakarta Connect - Government Project Monitoring and Citizen Forum Platform",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "phpmailer/phpmailer": "^6.9 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}